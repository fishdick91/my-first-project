# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/

# 虚拟环境
.venv/
venv/
env/

# 配置与密钥
.env
.env.local
*.pem

# 登录 Cookie（本地凭证，禁止提交）
cookies/*
!cookies/.gitkeep

# 数据文件
*.duckdb
*.db
*.sqlite
# data/ 目录保留结构（.gitkeep），但忽略所有产物文件
data/**/*
!data/.gitkeep
!data/**/.gitkeep

# 编辑器
.idea/
.vscode/
*.swp
*.swo

# 系统
.DS_Store
Thumbs.db

# 日志
*.log
logs/

# 生成的可视化产物
output/
