# 环境变量示例 —— 复制为 .env 后填入真实值，.env 不会被提交到 GitHub
# 两种写法任选其一，分项配置更灵活：

# ===== 方式 A：分项配置（推荐）=====
MYSQL_HOST=10.112.183.66
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=data_pipeline

# ===== 方式 B：完整 URL（优先级更高，有则优先用）=====
# MYSQL_URL=mysql+pymysql://root:your_password@10.112.183.66:3306/data_pipeline

# ===== AI 层（默认智谱 GLM-4-Flash，免费）=====
# 换成 DeepSeek / 通义千问时，只改这三行：
#   DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your_zhipu_api_key
LLM_MODEL=glm-4-flash
